diff --git a/QCEDL.NET.Tests/QualcommFirehoseConfigureTests.cs b/QCEDL.NET.Tests/QualcommFirehoseConfigureTests.cs
new file mode 100644
--- /dev/null
+++ b/QCEDL.NET.Tests/QualcommFirehoseConfigureTests.cs
@@ -0,0 +1,32 @@
+using System.Text;
+using System.Xml.Linq;
+using Qualcomm.EmergencyDownload.Layers.APSS.Firehose;
+using Qualcomm.EmergencyDownload.Layers.APSS.Firehose.Xml.Elements;
+
+namespace QCEDL.NET.Tests;
+
+public sealed class QualcommFirehoseConfigureTests
+{
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void LitePayloadIsSentAndRemembered(bool skipStorageInit)
+    {
+        using var transport = new FirehoseEraseRecordingTransport("<data><response value=\"ACK\" /></data>"u8.ToArray());
+        var firehose = new QualcommFirehose(transport);
+        Assert.True(firehose.Configure(StorageType.Ufs, skipStorageInit, 16384));
+        var xml = XDocument.Parse(Encoding.UTF8.GetString(Assert.Single(transport.Commands))).Root!.Element("configure")!;
+        Assert.Equal("16384", xml.Attribute("MaxPayloadSizeToTargetInBytes")!.Value);
+        Assert.Equal(skipStorageInit ? "1" : "0", xml.Attribute("SkipStorageInit")!.Value);
+        Assert.Equal(16384UL, firehose.MaxPayloadSize);
+    }
+
+    [Fact]
+    public void RejectedConfigurationDoesNotChangeTransferLimit()
+    {
+        using var transport = new FirehoseEraseRecordingTransport("<data><response value=\"NAK\" /></data>"u8.ToArray());
+        var firehose = new QualcommFirehose(transport);
+        Assert.False(firehose.Configure(StorageType.Ufs, true, 16384));
+        Assert.Equal(1048576UL, firehose.MaxPayloadSize);
+    }
+}
diff --git a/QCEDL.NET.Tests/QualcommFirehoseFramingTests.cs b/QCEDL.NET.Tests/QualcommFirehoseFramingTests.cs
