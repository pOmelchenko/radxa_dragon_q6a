@@ -0,0 +1,28 @@
+using System.Text;
+using Qualcomm.EmergencyDownload.Layers.APSS.Firehose;
+
+namespace QCEDL.NET.Tests;
+
+public sealed class QualcommFirehoseFramingTests
+{
+    [Fact]
+    public void CoalescedAckAndBinaryRetainEveryByte()
+    {
+        byte[] binary = [0, 0, 255, 13, 10, 60, 62, 128];
+        var ack = "<data><response value=\"ACK\" rawmode=\"true\" /></data>"u8.ToArray();
+        using var transport = new FirehoseEraseRecordingTransport([.. ack, .. binary]);
+        var firehose = new QualcommFirehose(transport);
+        _ = Assert.Single(firehose.GetFirehoseResponseDataPayloads());
+        Assert.Equal(binary, firehose.GetExpectedBufferLength(binary.Length));
+    }
+    [Fact]
+    public void SplitFooterAndNextResponseArePreserved()
+    {
+        using var transport = new FirehoseEraseRecordingTransport(
+            "<data><response value=\"ACK\" /></da"u8.ToArray(),
+            "ta><data><response value=\"NAK\" /></data>"u8.ToArray());
+        var firehose = new QualcommFirehose(transport);
+        Assert.Contains("ACK", Encoding.UTF8.GetString(firehose.GetFirehoseXmlResponseBuffer()));
+        Assert.Contains("NAK", Encoding.UTF8.GetString(firehose.GetFirehoseXmlResponseBuffer()));
+    }
+}
diff --git a/QCEDL.NET/Layers/APSS/Firehose/BufferedFirehoseTransport.cs b/QCEDL.NET/Layers/APSS/Firehose/BufferedFirehoseTransport.cs
new file mode 100644
--- /dev/null
+++ b/QCEDL.NET/Layers/APSS/Firehose/BufferedFirehoseTransport.cs
@@ -0,0 +1,44 @@
+using Qualcomm.EmergencyDownload.Transport;
+
+namespace Qualcomm.EmergencyDownload.Layers.APSS.Firehose;
+
+internal sealed class BufferedFirehoseTransport(IQualcommTransport inner) : IQualcommTransport
+{
+    private byte[] _pending = [];
+    public TransportBackend Backend => inner.Backend;
+    public int TimeoutMilliseconds { get => inner.TimeoutMilliseconds; set => inner.TimeoutMilliseconds = value; }
+    internal void Prepend(ReadOnlySpan<byte> bytes)
+    {
+        if (!bytes.IsEmpty)
+        {
+            _pending = [.. bytes.ToArray(), .. _pending];
+        }
+    }
+    public int Read(byte[] buffer, int offset, int count)
+    {
+        if (_pending.Length == 0)
+        {
+            return inner.Read(buffer, offset, count);
+        }
+
+        var length = Math.Min(count, _pending.Length);
+        _pending.AsSpan(0, length).CopyTo(buffer.AsSpan(offset, length));
+        _pending = _pending.AsSpan(length).ToArray();
+        return length;
+    }
+    public int Write(byte[] buffer, int offset, int count)
+    {
+        return inner.Write(buffer, offset, count);
+    }
+
+    public void SendZeroLengthPacket()
+    {
+        inner.SendZeroLengthPacket();
+    }
+
+    public void Dispose()
+    {
+        inner.Dispose();
+    }
+}
+
